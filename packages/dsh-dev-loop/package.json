{
  "name": "dsh-dev-loop",
  "version": "0.9.0",
  "description": "DSH Dev Loop — project-level Build/Test/Run/Restart development panel for DeepSeek Harness",
  "homepage": "https://github.com/nzl153/dsh-dev-loop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nzl153/dsh-dev-loop.git"
  },
  "bugs": {
    "url": "https://github.com/nzl153/dsh-dev-loop/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "developer-tools",
    "devtools",
    "dev-loop",
    "build",
    "test",
    "run",
    "watch"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "dev": "tsdown --config ./tsdown.config.ts --watch",
    "dev:client": "tsdown --config ./tsdown.config.ts --watch",
    "build": "tsdown --config ./tsdown.config.ts && node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node tests/smoke.mjs",
    "test:unit": "vitest run",
    "test:smoke": "node tests/smoke.mjs",
    "verify:hmr": "node scripts/verify-hmr.mjs",
    "preset": "node scripts/generate-preset.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.2.0",
    "dsh-toolkit-ui": "link:..\\dsh-toolkit-ui",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
