{
  "name": "dsh-session-archaeologist",
  "version": "1.0.0-rc.1",
  "description": "Session Archaeologist — cross-session full-text search over local DSH sessions with SQLite FTS5, scoped filters, timeline summaries, and bounded bring-to-context excerpts. 会话考古：本地 session 全文检索 / 作用域过滤 / 结构化时间线 / 受限摘要注入当前上下文。",
  "homepage": "https://github.com/nzl153/dsh-session-archaeologist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nzl153/dsh-session-archaeologist.git"
  },
  "bugs": {
    "url": "https://github.com/nzl153/dsh-session-archaeologist/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "developer-tools",
    "session-search",
    "session",
    "search",
    "fts5",
    "sqlite",
    "history"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsdown --config ./tsdown.config.ts --watch",
    "build": "tsdown --config ./tsdown.config.ts && node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node tests/smoke.mjs",
    "test:unit": "vitest run",
    "test:smoke": "node tests/smoke.mjs",
    "bench": "node scripts/bench.mjs",
    "verify:hmr": "node scripts/verify-hmr.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.2.0",
    "dsh-toolkit-ui": "link:..\\dsh-toolkit-ui",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
