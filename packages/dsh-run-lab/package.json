{
  "name": "dsh-run-lab",
  "version": "0.8.0",
  "description": "DSH Agent experiment & A/B comparison — run the same coding task in two isolated workspaces and compare objective metrics (wall time, turns, tokens, diff, evaluator results).",
  "homepage": "https://github.com/nzl153/dsh-devtools/tree/main/packages/dsh-run-lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nzl153/dsh-devtools.git",
    "directory": "packages/dsh-run-lab"
  },
  "bugs": {
    "url": "https://github.com/nzl153/dsh-devtools/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "developer-tools",
    "benchmark",
    "experiment",
    "ab-test",
    "evaluator",
    "worktree"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cli": {
      "types": "./lib/types/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-run-lab": "./lib/cli.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "dev": "tsdown --config ./tsdown.config.ts --watch",
    "dev:client": "tsdown --config ./tsdown.config.ts --watch",
    "build": "tsdown --config ./tsdown.config.ts && node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node tests/smoke.mjs",
    "test:unit": "vitest run",
    "test:smoke": "node tests/smoke.mjs",
    "verify:hmr": "node scripts/verify-hmr.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.2.0",
    "dsh-toolkit-ui": "link:..\\dsh-toolkit-ui",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
