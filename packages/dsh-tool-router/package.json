{
  "name": "dsh-tool-router",
  "version": "0.1.0",
  "description": "DSH Tool Router — deterministically shrink model-visible tool schemas per step with a safe fallback",
  "homepage": "https://github.com/nzl153/dsh-devtools/tree/main/packages/dsh-tool-router",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nzl153/dsh-devtools.git",
    "directory": "packages/dsh-tool-router"
  },
  "bugs": {
    "url": "https://github.com/nzl153/dsh-devtools/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "developer-tools",
    "tool-router",
    "token",
    "context"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./core": {
      "default": "./lib/core.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsdown --config ./tsdown.config.ts --watch",
    "build": "tsdown --config ./tsdown.config.ts && node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify:hmr": "node scripts/verify-hmr.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  }
}
